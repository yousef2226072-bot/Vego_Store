# Leave empty to use same-origin /api (dev proxy or backend serving dist/).
# Set to e.g. https://api.vegostore.com only if the API lives on another origin
# (then the backend must send CORS headers with credentials).
VITE_API_BASE_URL=
VITE_SITE_URL=https://vegostore.example.com
# Dev proxy target
VITE_DEV_API=http://localhost:3000
